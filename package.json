{
  "name": "hogar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @hogar/web dev",
    "dev:socket": "pnpm --filter @hogar/socket-server dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @hogar/database generate",
    "db:migrate": "pnpm --filter @hogar/database migrate",
    "db:push": "pnpm --filter @hogar/database push",
    "db:studio": "pnpm --filter @hogar/database studio",
    "db:seed": "pnpm --filter @hogar/database seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@hogar/typescript-config": "workspace:*",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
