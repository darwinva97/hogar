# ===========================================
# Hogar - Variables de Entorno
# ===========================================
# Copia este archivo a .env y ajusta los valores

# Base de datos PostgreSQL (REQUERIDO)
DATABASE_URL="postgresql://hogar:hogar_dev_password@localhost:5432/hogar"

# ---------------------------------------------
# SERVICIOS OPCIONALES PARA DESARROLLO LOCAL
# Descomenta según necesites
# ---------------------------------------------

# Redis (para Socket.io scaling en producción)
# REDIS_URL="redis://localhost:6379"

# Socket.io (para notificaciones en tiempo real)
# NEXT_PUBLIC_SOCKET_URL="http://localhost:4041"
# SOCKET_PORT=4041
# CORS_ORIGIN="http://localhost:4040"

# Meilisearch (para búsqueda avanzada)
# En desarrollo se usa búsqueda SQL básica
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_API_KEY="hogar_meili_dev_key"

# ---------------------------------------------
# STORAGE
# ---------------------------------------------
# Tipo: 'local' para desarrollo, 's3' para producción
STORAGE_TYPE="local"

# S3 / Backblaze B2 / MinIO (solo si STORAGE_TYPE=s3)
# Para Backblaze B2: https://s3.us-west-000.backblazeb2.com
# Para AWS S3: https://s3.us-east-1.amazonaws.com
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET="hogar"
# S3_REGION="us-east-1"
# S3_PUBLIC_URL=""

# ---------------------------------------------
# EMAIL
# ---------------------------------------------
# En desarrollo los emails se loguean en consola
# Para testing usar Mailpit: docker run -p 1025:1025 -p 8025:8025 mailpit/mailpit
# SMTP_HOST="localhost"
# SMTP_PORT=1025
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="Hogar <noreply@hogar.pe>"

# ---------------------------------------------
# AUTH (REQUERIDO)
# ---------------------------------------------
# Genera con: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-change-in-production"
AUTH_URL="http://localhost:4040"

# Google OAuth (opcional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------
# PAGOS
# ---------------------------------------------
# Culqi (Perú) - para pagos con tarjeta
# En desarrollo se usan pagos manuales (Yape, Plin, transferencia)
# CULQI_PUBLIC_KEY=""
# CULQI_SECRET_KEY=""

# ---------------------------------------------
# INTEGRACIONES OPCIONALES
# ---------------------------------------------

# WhatsApp Business API
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""

# OpenAI (para chat/asistente)
# OPENAI_API_KEY=""

# Replicate (para generación de imágenes)
# REPLICATE_API_TOKEN=""

# ---------------------------------------------
# APP (REQUERIDO)
# ---------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:4040"
NEXT_PUBLIC_APP_NAME="Hogar"
NODE_ENV="development"
